ENVIRONMENT=local
SPORTVID_BACKEND_CONFIG=config/backend.json
COMPOSE_PROJ_NAME=sportvid
DEBUG=True
HF_HOME=/models
NUMBA_CACHE_DIR=/tmp
POSTGRES_DB=sportvid
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_PORT=5432
BACKEND_PORT=8010
FRONTEND_PORT=9000
VALKEY_CLIENT_HOST=valkey
VALKEY_INTERNAL_HOST=0.0.0.0
VALKEY_INTERNAL_PORT=6380
# empty for the local stack (valkey listens on 127.0.0.1 only); required on the servers
VALKEY_PASSWD=
# local development admin, created/refreshed at backend start (manage.py ensure_dev_admin, refuses outside ENVIRONMENT=local)
DEV_ADMIN_USERNAME=admin
DEV_ADMIN_PASSWORD=sportvid-dev-admin
# seconds one plugin run (one analyser/Ray call) may take before it is stopped as ERROR
PLUGIN_RUN_TIMEOUT=43200
# HLS video encoder: auto (NVENC if the gpu worker can use it, else libx264), nvenc or x264
HLS_ENCODER=auto
GRPC_HOST=analyser
GRPC_PORT=50051
INFERENCE_RAY_STATUS_PORT=52365
DATA_PATH=./data
GUNICORN_WORKERS=4
LOG_LEVEL=debug